{
  "schemaVersion": 1,
  "name": "keyvault-secrets",
  "kind": "data",
  "steps": {
    "vault": {
      "family": "keyvault.vaults",
      "operation": "create",
      "mode": "service",
      "parameters": {
        "generator": "recipe.vault",
        "count": 1
      },
      "dependsOn": [
        "group",
        "providers"
      ],
      "target": "vault"
    },
    "secret": {
      "family": "keyvault.secrets",
      "operation": "set",
      "mode": "service",
      "parameters": {
        "generator": "recipe.secret",
        "count": 1
      },
      "dependsOn": [
        "vault"
      ]
    }
  },
  "resources": {
    "vault": {
      "family": "keyvault.vaults"
    }
  }
}
